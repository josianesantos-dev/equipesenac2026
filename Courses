from fastapi import APIRouter, HTTPException, Response, status

from app.services.courses_service import delete_course, get_course_by_id, list_courses

router = APIRouter(prefix="/courses", tags=["Courses"])


@router.get("", status_code=status.HTTP_200_OK)
def get_courses():
    todos_os_cursos = list_courses()
    cursos_ativos = [curso for curso in todos_os_cursos if curso.get("active") == True]
    return cursos_ativos


@router.get("/{course_id}")
def get_course(course_id: int):
    course = get_course_by_id(course_id)

    if not course:
        raise HTTPException(
        status_code=status.HTTP_404_NOT_FOUND,
        detail="Curso não encontrado"
    )


